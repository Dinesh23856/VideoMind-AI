# Application
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-in-production

# Storage
SCRATCH_DIR=/tmp/media_proc

# Redis / Celery  (on Render these are auto-injected from vtk-redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── ASR ──────────────────────────────────────────────────────────────
# On Render use "groq" or "deepgram" (no GPU). Locally you can use faster-whisper.
ASR_PROVIDER=groq
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Local Whisper (only if ASR_PROVIDER=faster-whisper)
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BATCH_SIZE=8

# ── LLM (required) ───────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=8192

# Notion (optional)
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]
